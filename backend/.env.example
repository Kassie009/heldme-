# Plantilla de variables de entorno — backend HeldMe!
# Copiar como .env y completar. El .env NUNCA se sube al repositorio (ARQ-03).

# Servidor
PORT=3000
NODE_ENV=development

# Supabase (service_role SOLO aquí en el backend; las apps usan la anon key)
SUPABASE_URL=https://TU-PROYECTO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=service_role_key_aqui
SUPABASE_ANON_KEY=anon_key_aqui

# Gemini API — desde el backend únicamente (RN-10, RNF-14)
GEMINI_API_KEY=clave_aqui

# Stripe — SOLO Test Mode (ARQ-08: nunca Live Mode)
STRIPE_SECRET_KEY=sk_test_aqui
STRIPE_WEBHOOK_SECRET=whsec_aqui

# Seguridad
JWT_EXPIRES_IN=1h        # RNF-01: expiración máxima de 1 hora
